# ---- Vivado build output (regenerable, large) ----
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
.Xil/
*.jou
*.log
*.str
*.wdb
*.pb
*.bit
*.ltx
*.dcp

# Tracked on purpose so a fresh clone opens in Vivado:
#   *.xpr    the project file
#   *.srcs/  sources, constraints, block diagrams
#   *.gen/   generated block-design output products (incl. the HDL wrapper)

# ---- iverilog / gtkwave artifacts ----
build/
*.vvp
*.vcd

# ---- local notes, not part of the assignment ----
docs/

# ---- OS noise ----
.DS_Store
Thumbs.db

# ---- lab2 standalone sim: generated by `make` from the .s sources ----
lab2/sim/*.mem
lab2/sim/*.lst

# ---- python ----
__pycache__/
*.pyc

*.xsa
*.bak

# ---- lab2/template and lab2/solution: complete Vivado projects ----
# template is the untouched download, solution is the same project with lwi
# added. Both keep every file, so they open in Vivado exactly as they are here.
!lab2/template/**
!lab2/solution/**
# ...except what Vitis builds inside a workspace. solution/workspace is kept as
# an empty folder because the manual has you select it.
lab2/template/workspace/*
lab2/solution/workspace/*
!lab2/solution/workspace/.gitkeep
