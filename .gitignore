# ---- Vivado build output (regenerable, large) ----
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
.Xil/
*.jou
*.log
*.str
*.wdb
*.pb
*.bit
*.ltx
*.dcp

# Tracked on purpose so a fresh clone opens in Vivado:
#   *.xpr    the project file
#   *.srcs/  sources, constraints, block diagrams
#   *.gen/   generated block-design output products (incl. the HDL wrapper)

# ---- iverilog / gtkwave artifacts ----
build/
*.vvp
*.vcd

# ---- local notes, not part of the assignment ----
docs/

# ---- OS noise ----
.DS_Store
Thumbs.db

# ---- lab2 standalone sim: generated by `make` from the .s sources ----
lab2/sim/*.mem
lab2/sim/*.lst

# ---- python ----
__pycache__/
*.pyc

# ---- lab2 template: keep only what opening the project needs ----
# From .gen, only the HDL wrapper is referenced by the .xpr; the rest (IP
# output products, ~58 MB) Vivado regenerates on first synthesis/simulation.
lab2/pico32_final/pico32.gen/*
!lab2/pico32_final/pico32.gen/sources_1/
lab2/pico32_final/pico32.gen/sources_1/*
!lab2/pico32_final/pico32.gen/sources_1/bd/
lab2/pico32_final/pico32.gen/sources_1/bd/*
!lab2/pico32_final/pico32.gen/sources_1/bd/design_1/
lab2/pico32_final/pico32.gen/sources_1/bd/design_1/*
!lab2/pico32_final/pico32.gen/sources_1/bd/design_1/hdl/
# Vitis workspace: the manual has you select this folder, so keep it,
# but not the platform and build output Vitis puts in it
lab2/pico32_final/workspace/*
!lab2/pico32_final/workspace/.gitkeep
*.xsa
*.bak
# incremental-synthesis checkpoint the .xpr references
!lab2/pico32_final/pico32.srcs/utils_1/imports/synth_1/picorv32_axi.dcp

# ---- lab2/template: untouched reference copy, keep every file ----
!lab2/template/**
