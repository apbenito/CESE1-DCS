# Tracked on purpose so a fresh clone opens in Vivado:
#   *.xpr    the project file
#   *.srcs/  sources, constraints, block diagrams
#   *.gen/   generated block-design output products (incl. the HDL wrapper)

# ---- iverilog / gtkwave artifacts ----
build/
*.vvp
*.vcd

# ---- local notes, not part of the assignment ----
docs/

# ---- OS noise ----
.DS_Store
Thumbs.db

# ---- lab2 standalone sim: generated by `make` from the .s sources ----
lab2/sim/*.mem
lab2/sim/*.lst

# ---- python ----
__pycache__/
*.pyc
